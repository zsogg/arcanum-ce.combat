# CE (release 1, R9): the build's version, for the log a player attaches to a
# bug report. Run at every build (the `arcanum-ce-version` target); writes
# OUT only when the version changed, so an unchanged build recompiles nothing.
#   cmake -DSRC=<source dir> -DOUT=<header> -P ce_version.cmake
execute_process(
    COMMAND git describe --always --dirty --abbrev=7 --exclude=*
    WORKING_DIRECTORY "${SRC}"
    OUTPUT_VARIABLE CE_VERSION
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR CE_VERSION STREQUAL "")
    set(CE_VERSION "unknown")
endif()
set(content "/* Generated by cmake/ce_version.cmake; do not edit. */\n#define ARCANUM_CE_VERSION \"${CE_VERSION}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
