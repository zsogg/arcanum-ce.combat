{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}"
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-x86-base",
            "hidden": true,
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-m32",
                "CMAKE_CXX_FLAGS": "-m32",
                "CMAKE_SYSTEM_NAME": "Linux",
                "CMAKE_SYSTEM_PROCESSOR": "i386"
            }
        },
        {
            "name": "linux-x86-debug",
            "inherits": [
                "linux-x86-base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-x86-release",
            "inherits": [
                "linux-x86-base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-x64-debug",
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-x64-asan",
            "displayName": "Linux x64 Debug + ASan/UBSan",
            "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer. Kept separate from linux-x64-debug on purpose: the smoke gate's baseline (exit 137, four stock InvenSource.mes errors) is calibrated against the plain debug build, and sanitizers change timing, memory layout and exit status.",
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ARCANUM_BUILD_TESTS": "ON",
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "linux-x64-asan-release",
            "displayName": "Linux x64 Release + ASan/UBSan",
            "description": "The release's optimization (-O3 -DNDEBUG) with the ASan preset's sanitizers, for release 1's R6: what the shipped binary's compiler does with the code, instrumented. Keeps static functions and data out of line so the tests' globalized copies exist.",
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ARCANUM_BUILD_TESTS": "ON",
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined -fkeep-static-functions -fno-ipa-reference-addressable",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "windows-x64-mingw",
            "displayName": "Windows x64 (cross-compiled from Linux with mingw-w64)",
            "description": "Produces a self-contained arcanum-ce.exe from a Linux host. CE's own windows-* presets need a Windows host and Visual Studio; this is the cross path. Requires: sudo apt install mingw-w64",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/mingw-w64-x86_64.cmake"
            }
        },
        {
            "name": "windows-x64-mingw-tests",
            "displayName": "Windows x64 (MinGW) Release, unit tests",
            "description": "The Windows release's optimization with the C suite, for release 1's R6, run under Wine. The shipped tree, windows-x64-mingw, carries no test code; this sibling keeps static functions and data out of line for the tests' globalized copies.",
            "inherits": [
                "windows-x64-mingw"
            ],
            "cacheVariables": {
                "ARCANUM_BUILD_TESTS": "ON",
                "CMAKE_C_FLAGS": "-fkeep-static-functions -fno-ipa-reference-addressable"
            }
        },
        {
            "name": "linux-x64-release",
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-x64-release-tests",
            "displayName": "Linux x64 Release, unit tests",
            "description": "The shipped preset's optimization (-O3 -DNDEBUG) with the C suite and emudiff oracle, for release 1's R6. The shipped tree, linux-x64-release, carries no test code; this sibling keeps static functions and data out of line (-fkeep-static-functions, -fno-ipa-reference-addressable), which the tests' globalized copies need.",
            "inherits": [
                "linux-x64-release"
            ],
            "cacheVariables": {
                "ARCANUM_BUILD_TESTS": "ON",
                "CMAKE_C_FLAGS": "-fkeep-static-functions -fno-ipa-reference-addressable"
            }
        },
        {
            "name": "linux-arm64-debug",
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-arm64-release",
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "generator": "Visual Studio 17 2022"
        },
        {
            "name": "windows-x86",
            "inherits": [
                "windows-base"
            ],
            "architecture": "Win32"
        },
        {
            "name": "windows-x64",
            "inherits": [
                "windows-base"
            ],
            "architecture": "x64"
        },
        {
            "name": "windows-arm64",
            "inherits": [
                "windows-base"
            ],
            "architecture": "arm64"
        },
        {
            "name": "darwin-base",
            "hidden": true,
            "inherits": [
                "base"
            ],
            "generator": "Xcode",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos",
            "inherits": [
                "darwin-base"
            ],
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "10.13"
            }
        },
        {
            "name": "ios",
            "inherits": [
                "darwin-base"
            ],
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
                "CMAKE_XCODE_ATTRIBUTE_CODE_SIGN_IDENTITY": ""
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-x86-debug",
            "configurePreset": "linux-x86-debug"
        },
        {
            "name": "linux-x86-release",
            "configurePreset": "linux-x86-release"
        },
        {
            "name": "linux-x64-debug",
            "configurePreset": "linux-x64-debug"
        },
        {
            "name": "linux-x64-asan",
            "configurePreset": "linux-x64-asan"
        },
        {
            "name": "linux-x64-asan-release",
            "configurePreset": "linux-x64-asan-release"
        },
        {
            "name": "windows-x64-mingw",
            "configurePreset": "windows-x64-mingw"
        },
        {
            "name": "windows-x64-mingw-tests",
            "configurePreset": "windows-x64-mingw-tests"
        },
        {
            "name": "linux-x64-release",
            "configurePreset": "linux-x64-release"
        },
        {
            "name": "linux-x64-release-tests",
            "configurePreset": "linux-x64-release-tests"
        },
        {
            "name": "linux-arm64-debug",
            "configurePreset": "linux-arm64-debug"
        },
        {
            "name": "linux-arm64-release",
            "configurePreset": "linux-arm64-release"
        },
        {
            "name": "windows-x86-debug",
            "configurePreset": "windows-x86",
            "configuration": "Debug"
        },
        {
            "name": "windows-x86-release",
            "configurePreset": "windows-x86",
            "configuration": "Release"
        },
        {
            "name": "windows-x64-debug",
            "configurePreset": "windows-x64",
            "configuration": "Debug"
        },
        {
            "name": "windows-x64-release",
            "configurePreset": "windows-x64",
            "configuration": "Release"
        },
        {
            "name": "windows-arm64-debug",
            "configurePreset": "windows-arm64",
            "configuration": "Debug"
        },
        {
            "name": "windows-arm64-release",
            "configurePreset": "windows-arm64",
            "configuration": "Release"
        },
        {
            "name": "macos-debug",
            "configurePreset": "macos",
            "configuration": "Debug"
        },
        {
            "name": "macos-release",
            "configurePreset": "macos",
            "configuration": "Release"
        },
        {
            "name": "ios-debug",
            "configurePreset": "ios",
            "configuration": "Debug"
        },
        {
            "name": "ios-release",
            "configurePreset": "ios",
            "configuration": "Release"
        }
    ]
}
